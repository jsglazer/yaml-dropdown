{
	"name": "yaml-dropdown",
	"version": "1.0.1",
	"description": "Dropdown suggestions for frontmatter values in Obsidian, scoped per folder, per file, or by DropdownClass.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit -p tsconfig.json && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": ["obsidian", "plugin", "frontmatter", "yaml", "dropdown"],
	"author": "Josh Glazer",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@types/node": "^25.9.3",
		"esbuild": "0.28.1",
		"obsidian": "latest",
		"tslib": "2.8.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	}
}
